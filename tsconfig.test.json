{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // `sync-version.test.ts` imports the release script itself, which is plain
    // ESM. Reading it is the point — the script has no separate types, and a
    // `.mjs` left unchecked is how the test would go on calling a function
    // that had changed shape.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs"]
}
